# =============================================================================
#  PAI Guides — переменные окружения
# =============================================================================
#  Скопируйте этот файл в .env (start.cmd делает это сам, если .env нет).
#  Значения по умолчанию рассчитаны на ЛОКАЛЬНЫЙ запуск без единого внешнего
#  аккаунта: хранилище — папка на диске, бэкап — папка на диске, Telegram —
#  вывод в консоль, CDN purge — заглушка с логом.
#
#  Каждый блок помечен:
#    [локально]  — работает как есть, менять не нужно
#    [прод]      — заполняется при выкатке на сервер (см. SETUP.md)
# =============================================================================


# ============================ PostgreSQL [локально] ==========================
POSTGRES_USER=pai
POSTGRES_PASSWORD=pai_password
POSTGRES_DB=pai
POSTGRES_PORT=5432
# Строка подключения для backend, запущенного НА ХОСТЕ (npm run dev).
# Внутри docker-compose она подменяется на postgres:5432 автоматически.
DATABASE_URL=postgresql://pai:pai_password@localhost:5432/pai


# ============================== Backend [локально] ===========================
BACKEND_PORT=3001
NODE_ENV=development
# Уровень логов Fastify: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Секрет подписи JWT. ОБЯЗАТЕЛЬНО поменять на проде.
# Сгенерировать:  openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me-please-32-chars-min
# Время жизни access-токена (в cookie) и refresh-токена
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Домен для cookie. Локально — ПУСТО (host-only cookie на localhost).
# На проде: .pai.1sx.biz — чтобы одна кука работала на всех поддоменах.
COOKIE_DOMAIN=
# Secure-флаг у cookie. Локально false (нет https), на проде — true.
COOKIE_SECURE=false
# Стоимость bcrypt-хеша пароля
BCRYPT_COST=12

# Домены, которым разрешён CORS с credentials (через запятую).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173


# ============================= Фронтенды [локально] ==========================
WEB_PORT=3000
ADMIN_PORT=5173
# Публичные URL сервисов — используются в письмах, ссылках бота и CORS
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:5173
# Куда фронты ходят за API
VITE_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001


# ============================ Первый администратор ===========================
# Создаётся скриптом seed при первом запуске. Вход в админку — по логину и паролю.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Администратор
ADMIN_EMAIL=admin@example.com
# Telegram-username первого админа без @ (можно оставить пустым)
ADMIN_TELEGRAM_USERNAME=


# ======================= Объектное хранилище (медиа) =========================
# local — папка на диске (по умолчанию, ничего не нужно заводить)
# r2    — Cloudflare R2 (или любой S3-совместимый: MinIO, Backblaze B2)
STORAGE_PROVIDER=local

# --- local [локально] ---
# Куда складывать файлы. Относительный путь считается от корня репозитория.
STORAGE_LOCAL_DIR=./storage
# По какому URL backend отдаёт эти файлы наружу
STORAGE_LOCAL_PUBLIC_URL=http://localhost:3001/media

# --- r2 [прод] -------------------------------------------------------------
# Где взять: dash.cloudflare.com → R2 → Create bucket → затем
#   «Manage R2 API Tokens» → Create API token (Object Read & Write).
# Account ID виден в правой колонке дашборда R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pai-media
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Публичный домен бакета (R2 → Settings → Public access → Connect Domain).
# Именно он попадёт в <img src>, поэтому должен быть за Cloudflare CDN.
R2_PUBLIC_URL=https://media.pai.1sx.biz
# Регион. У R2 его нет — отсюда 'auto'. У Hetzner, Backblaze и прочих S3
# регион входит в подпись запроса, и с 'auto' они отвечают 403.
R2_REGION=auto
# Адресация «бакет в пути» (bucket в URL, а не поддоменом). Нужна MinIO
# и другим self-hosted сборкам; для R2 оставьте false.
R2_FORCE_PATH_STYLE=false


# ================================ Медиа ======================================
# Лимит на картинку (МБ) и на видео (МБ)
MEDIA_IMAGE_MAX_MB=25
MEDIA_VIDEO_MAX_MB=2048
# Путь к ffmpeg/ffprobe. Если пусто — ищется в PATH.
# Без ffmpeg видео всё равно загрузится и будет играть, но не будет постера
# и нормализации битрейта (см. PROGRESS.md, этап 3.4).
FFMPEG_PATH=
FFPROBE_PATH=


# ============================== Telegram =====================================
# console  — писать сообщения в лог сервера (по умолчанию, бот не нужен)
# telegram — реально слать через бота
TELEGRAM_PROVIDER=console
# [прод] Токен бота от @BotFather (/newbot → скопировать токен)
TELEGRAM_BOT_TOKEN=
# [прод] Юзернейм бота без @ — нужен для Telegram Login Widget
TELEGRAM_BOT_USERNAME=
# [прод] Chat ID, куда слать алерты (напишите боту, потом
# https://api.telegram.org/bot<TOKEN>/getUpdates и возьмите chat.id)
TELEGRAM_ALERT_CHAT_ID=


# ================================ CDN ========================================
# noop       — ничего не делать, только лог (по умолчанию)
# cloudflare — реальный purge через API
CDN_PROVIDER=noop
# [прод] dash.cloudflare.com → домен → Overview → Zone ID (правая колонка)
CLOUDFLARE_ZONE_ID=
# [прод] My Profile → API Tokens → Create Token → шаблон «Zone.Cache Purge»
CLOUDFLARE_API_TOKEN=

# Секрет для on-demand ревалидации Next.js (backend → web).
# Любая случайная строка, одинаковая в backend и web.
REVALIDATE_SECRET=dev-revalidate-secret
# Внутренний URL Next.js, куда backend стучится за ревалидацией
WEB_INTERNAL_URL=http://localhost:3000


# ================================ Бэкап ======================================
# local-drive — папка на диске, полная логика инкрементальности (по умолчанию)
# google-drive — реальный Google Drive по OAuth
BACKUP_PROVIDER=local-drive
# Куда складывать бэкапы у local-drive. Относительный путь — от корня репозитория.
BACKUP_LOCAL_DIR=./backups
# Имя корневой папки бэкапов (одинаково для обоих провайдеров)
BACKUP_ROOT_FOLDER_NAME=PAI Backups

# Расписание (cron, время сервера). Пустая строка отключает задачу.
BACKUP_CONTENT_CRON=0 * * * *
BACKUP_MEDIA_CRON=30 * * * *
BACKUP_DB_CRON=0 4 * * *
BACKUP_VERIFY_CRON=0 5 * * 0
# Ретеншен дампов БД: сколько дневных / недельных / месячных копий держать
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Сколько дней держать объекты, удалённые из системы, прежде чем чистить
BACKUP_TOMBSTONE_DAYS=30
# Алерт, если последний успешный бэкап был раньше, чем N часов назад
BACKUP_STALE_ALERT_HOURS=6
# Имя контейнера с Postgres. Нужно, чтобы делать дамп через pg_dump внутри него,
# когда на хосте pg_dump не установлен (обычный случай на чистой машине).
PGDUMP_DOCKER_CONTAINER=pai_postgres

# --- google-drive [прод] ---------------------------------------------------
# ⚠️ ТРИ ЛОВУШКИ, из-за каждой бэкап отваливается МОЛЧА — см. SETUP.md:
#   1. OAuth-приложение перевести в статус «In production»
#      (в «Testing» refresh-токен умирает через 7 дней)
#   2. Scope — только drive.file, НЕ drive
#   3. Авторизация с access_type=offline И prompt=consent
#
# console.cloud.google.com → APIs & Services → Credentials →
#   Create Credentials → OAuth client ID → тип «Desktop app»
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Получить командой:  npm run drive:auth  (в папке backend)
GOOGLE_REFRESH_TOKEN=
# Redirect URI для скрипта авторизации (localhost-callback)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:53682/oauth2callback


# ============================== Аналитика ====================================
# Порог «прочитано»: доля скролла и доля от расчётного времени чтения
ANALYTICS_READ_SCROLL_PCT=70
ANALYTICS_READ_TIME_RATIO=0.4
# Сколько дней хранить сырые события (агрегаты живут вечно)
ANALYTICS_RAW_RETENTION_DAYS=180
# Роллапы (cron)
ANALYTICS_ROLLUP_CRON=*/15 * * * *
ANALYTICS_ROLLUP_FULL_CRON=0 3 * * *
