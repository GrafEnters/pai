# Локальное объектное хранилище (local.provider) — сюда падают загруженные файлы.
# Ведущий слэш обязателен: без него шаблон матчит ЛЮБУЮ папку с таким именем,
# в том числе backend/src/services/storage — и исходники не попадают в репозиторий.
/storage/
# Локальный «Google Drive» (local-drive.provider) — сюда падают бэкапы
/backups/
# Временные файлы обработки медиа и восстановления
tmp/
.restore/
# Кэш wrangler (создаётся при работе с Cloudflare R2 из CLI)
.wrangler/
